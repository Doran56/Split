# Identifiants de l'application Bridge (dashboard.bridgeapi.io), sandbox ou production.
# Ne jamais commiter les vraies valeurs — configurer ces variables dans Vercel (Project Settings > Environment Variables).
BRIDGE_CLIENT_ID=
BRIDGE_CLIENT_SECRET=

# Version d'API Bridge (format daté, ex. 2025-01-15). Voir le dashboard pour la version recommandée actuelle.
BRIDGE_VERSION=2025-01-15

# Base URL de l'API Bridge. Généralement fixe, à surcharger seulement pour un environnement de test dédié.
BRIDGE_API_BASE=https://api.bridgeapi.io
